[configuration]

entry_symbol = "minerove_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/libminerove.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libminerove.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libminerove.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libminerove.windows.template_release.x86_64.dll"

[dependencies]

linux.x86_64 = {
    "res://bin/libBoardController.so": "",
    "res://bin/libDataHandler.so": "",
    "res://bin/libMLModule.so": "",
    "res://bin/libMindRoveWrapper.so": ""
}
