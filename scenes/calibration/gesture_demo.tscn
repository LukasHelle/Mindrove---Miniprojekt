[node name="GestureDemo" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_demo")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Status" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Press Calibrate and follow the instructions."

[node name="PhaseBar" type="ProgressBar" parent="Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
show_percentage = false

[node name="GesturePicks" type="HFlowContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16

[node name="PicksLabel" type="Label" parent="Margin/VBox/GesturePicks"]
layout_mode = 2
text = "Gestures:  rest (always)"

[node name="AddRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="PresetPicker" type="OptionButton" parent="Margin/VBox/AddRow"]
unique_name_in_owner = true
layout_mode = 2

[node name="NewGesture" type="LineEdit" parent="Margin/VBox/AddRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
placeholder_text = "or type a name"

[node name="AddButton" type="Button" parent="Margin/VBox/AddRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Add"

[node name="Rows" type="GridContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
columns = 3

[node name="Detected" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 48

[node name="ForceGraph" type="Control" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("2_force")

[node name="HudginsPlot" type="HBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("3_hudgins")

[node name="Buttons" type="HBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="CalibrateButton" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "Calibrate"

[node name="SaveButton" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "Save model"

[node name="LoadButton" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "Load model"

[node name="ExportButton" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "Export CSV"

[node name="PlayButton" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "Play"

[connection signal="item_selected" from="Margin/VBox/AddRow/PresetPicker" to="." method="_on_preset_selected"]
[connection signal="text_submitted" from="Margin/VBox/AddRow/NewGesture" to="." method="_on_new_gesture_submitted"]
[connection signal="pressed" from="Margin/VBox/AddRow/AddButton" to="." method="_add_new_gesture"]
[connection signal="pressed" from="Margin/VBox/Buttons/CalibrateButton" to="." method="_calibrate"]
[connection signal="pressed" from="Margin/VBox/Buttons/SaveButton" to="." method="_save_model"]
[connection signal="pressed" from="Margin/VBox/Buttons/LoadButton" to="." method="_load_model"]
[connection signal="pressed" from="Margin/VBox/Buttons/ExportButton" to="." method="_export_csv"]
[connection signal="pressed" from="Margin/VBox/Buttons/PlayButton" to="." method="_on_play_pressed"]
